# ════════════════════════════════════════════════════════════
# 手机自动化系统 — 环境变量样例
# 用法：cp .env.example .env  然后填入真实值（.env 已被 .gitignore 忽略，绝不要提交）
# ════════════════════════════════════════════════════════════

# ── Gitee 凭据（cloud_takeover / poller_v8 / push_dulwich 共用）──
# Gitee 账号用户名
GITEE_USER=wagziqag
# Gitee 私人令牌（PAT）。
# 重要：务必在 Gitee 平台【新建】令牌填入，不要复用已泄露的旧 token（be94810b...）。
# 旧 token 已进 Git 历史，须在 Gitee 撤销后此处只放新值。
GITEE_TOKEN=__FILL_YOUR_NEW_TOKEN_HERE__

# ── ZeroTermux 匹配码（真机接管通道，可选）──
# 手机端 ZeroTermux 的匹配码，仅经环境变量传入，不写明文进代码/日志/队列。
ZT_MATCH_CODE=__FILL_IF_NEEDED__
